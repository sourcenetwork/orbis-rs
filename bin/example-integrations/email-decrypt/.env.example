# Copy to .env (gitignored) and fill in real values. This is the ring's
# own mailbox: it sends every challenge email from this address, and its
# inbox is what "check for reply" polls.
#
# GMAIL_APP_PASSWORD is NOT your regular Google account password — Gmail
# requires 2-factor authentication to be enabled on the account, after
# which you can generate a 16-character App Password at
# https://myaccount.google.com/apppasswords specifically for this app.
# The regular account password will not work over SMTP/IMAP.

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
