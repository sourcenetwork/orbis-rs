FROM ubuntu:24.04
ARG VERA_REF
RUN test "$VERA_REF" = 490d9a5a2bc4ed27a04588ae156993aaa90f9ec5 && \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libssl3t64 libgcc-s1 netcat-openbsd && \
    curl -fsSL -o /tmp/verad.tar.gz \
      https://github.com/sourcenetwork/vera.rs/releases/download/v0.1.1/verad-x86_64-unknown-linux-gnu-regolith.tar.gz && \
    echo '203f1189bd491f04a1d56806e722ccef0f4cbc631e07c8d7d66055b0cd842998  /tmp/verad.tar.gz' | sha256sum -c - && \
    tar -xzf /tmp/verad.tar.gz -C /usr/local/bin verad && \
    echo '09b63062a150c0300c892d09421800ce7e416d0ae42eb3fd206f26d105486174  /usr/local/bin/verad' | sha256sum -c - && \
    rm -rf /var/lib/apt/lists/* /tmp/verad.tar.gz
LABEL org.opencontainers.image.revision=$VERA_REF
ENTRYPOINT ["verad"]
