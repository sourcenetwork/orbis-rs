# syntax=docker/dockerfile:1

FROM rust:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler cmake golang build-essential libclang-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

ARG CRYPTO_FEATURE=bls12-381
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --release -p orbis-bench --bin orbis-upgrade-driver \
        --no-default-features --features "${CRYPTO_FEATURE}" \
    && cp /app/target/release/orbis-upgrade-driver /orbis-upgrade-driver

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /data/dbs /artifacts
COPY --from=builder /orbis-upgrade-driver /usr/local/bin/orbis-upgrade-driver
WORKDIR /app
EXPOSE 50051 9090
ENTRYPOINT ["orbis-upgrade-driver"]
